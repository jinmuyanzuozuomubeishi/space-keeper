<Application x:Class="SpaceKeeper.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172E2D" />
    <SolidColorBrush x:Key="Accent" Color="#17675D" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="Background" Value="#F3F5F1" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,9" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Background" Value="#E5ECE6" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="MinHeight" Value="38" /></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="MinRowHeight" Value="38" /><Setter Property="Background" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="AlternatingRowBackground" Value="#F7F9F6" /><Setter Property="EnableRowVirtualization" Value="True" /></Style>
    <Style x:Key="PathCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="6" /></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10" /></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </Application.Resources>
</Application>
