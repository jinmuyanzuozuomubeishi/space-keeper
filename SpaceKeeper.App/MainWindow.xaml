<Window x:Class="SpaceKeeper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="空间守护 · 重复文件清理助手" Width="1280" Height="840" MinWidth="1020" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="空间守护" FontSize="30" FontWeight="Bold" /><TextBlock Text="先看清，再清理。让每一份保留都有依据。" Foreground="#5B706B" Margin="0,6,0,0" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="本地运行 · 不上传文件" Foreground="#17675D" VerticalAlignment="Center" Margin="0,0,18,0" /><Button Content="打开回收站恢复" Click="OpenRecycleBin" /></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0"><TextBlock Text="01 / 扫描目录" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox x:Name="RootsList" ItemsSource="{Binding Roots}" Height="65" BorderThickness="0" Background="#F5F7F3" HorizontalContentAlignment="Stretch" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="AddRootButton" Content="选择目录" Click="AddRoot" /><Button x:Name="RemoveRootButton" Content="移除选中" Click="RemoveRoot" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="02 / 受保护目录（只扫描，不清理）" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox x:Name="ProtectionList" ItemsSource="{Binding ProtectedFolders}" Height="65" BorderThickness="0" Background="#F5F7F3" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="AddProtectionButton" Content="添加保护" Click="AddProtection" /><Button x:Name="RemoveProtectionButton" Content="移除保护" Click="RemoveProtection" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="开始扫描" Background="{StaticResource Accent}" Foreground="White" Click="StartScan" /><Button x:Name="CancelButton" Content="取消任务" Margin="0,10,8,0" IsEnabled="False" Click="CancelTask" /></StackPanel>
      </Grid>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="White" BorderThickness="0">
      <TabItem Header="空间概览"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock x:Name="OverviewText" Text="选择个人文件目录后开始扫描。不会自动勾选或删除任何文件。" FontSize="18" Margin="0,0,0,16" />
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="目录占用 · 含子目录，数值不能相加" FontWeight="Bold" Margin="0,0,0,10" />
            <DataGrid x:Name="FoldersGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="目录" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource PathCell}" /><DataGridTextColumn Header="已扫描大小" Binding="{Binding Size}" Width="110" /></DataGrid.Columns></DataGrid>
          </Grid>
          <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="大文件 · 仅展示，不判断是否无用" FontWeight="Bold" Margin="0,0,0,10" />
            <DataGrid x:Name="LargeFilesGrid" Grid.Row="1" IsReadOnly="True" MouseDoubleClick="OpenLargeFileFolder"><DataGrid.Columns><DataGridTextColumn Header="名称 / 双击定位" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100" /></DataGrid.Columns></DataGrid>
          </Grid>
        </Grid>
      </Grid></TabItem>
      <TabItem Header="重复文件"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="仅显示内容完全一致的副本。每组保留一份；受保护目录的副本不能勾选清理。" Foreground="#5B706B" Margin="0,0,0,12" />
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <ListBox x:Name="GroupsList" DisplayMemberPath="Label" SelectionChanged="GroupChanged" Background="#F5F7F3" BorderThickness="0" Margin="0,0,14,0" />
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FileCards" /></ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="PreviewButton" Content="查看清理预览 →" Click="ShowPreview" DockPanel.Dock="Right" Background="{StaticResource Accent}" Foreground="White" /><TextBlock x:Name="SelectionText" Text="尚未选择清理副本" VerticalAlignment="Center" /></DockPanel>
      </Grid></TabItem>
      <TabItem Header="清理预览"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock x:Name="PreviewText" Text="先在重复文件页选择需要回收的副本。" FontSize="18" /><TextBlock Text="移入回收站通常不会立即释放空间。回收站清空后才会释放；本工具不自动清空。" Foreground="#8B5E22" Margin="0,8,0,0" /></StackPanel>
        <DataGrid x:Name="PreviewGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="将移入回收站" Binding="{Binding Target}" Width="*" ElementStyle="{StaticResource PathCell}" /><DataGridTextColumn Header="保留副本" Binding="{Binding Keeper}" Width="*" ElementStyle="{StaticResource PathCell}" /><DataGridTextColumn Header="副本大小" Binding="{Binding Size}" Width="110" /></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="ExecuteButton" Content="确认移入回收站" Background="{StaticResource Accent}" Foreground="White" IsEnabled="False" Click="ExecuteCleanup" /></StackPanel>
      </Grid></TabItem>
      <TabItem Header="跳过与说明"><DataGrid x:Name="IssuesGrid" Margin="18" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource PathCell}" /><DataGridTextColumn Header="跳过原因" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource PathCell}" /></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="操作记录"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><TextBlock x:Name="HistoryText" Text="记录只保存在本机。恢复请打开 Windows 回收站；清空后无法通过本工具恢复。" Margin="0,0,0,12" Foreground="#5B706B" />
        <DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=MM-dd HH:mm:ss}" Width="130" /><DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="130" /><DataGridTextColumn Header="文件" Binding="{Binding Target}" Width="*" ElementStyle="{StaticResource PathCell}" /><DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource PathCell}" /></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><ProgressBar x:Name="Progress" Height="4" IsIndeterminate="False" /><TextBlock x:Name="StatusText" Text="就绪 · 首版支持 Windows 11、本地 NTFS 个人文件目录" Margin="0,8,0,0" Foreground="#5B706B" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></StackPanel>
  </Grid>
</Window>
